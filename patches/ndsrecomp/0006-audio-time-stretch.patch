+    const size_t total_frames = input.size() / 2;
+    for (size_t offset = 0; offset < total_frames; offset += kChunk) {
+        const uint32_t frames
+            = static_cast<uint32_t>(std::min<size_t>(kChunk, total_frames - offset));
+        stretcher->push(input.data() + offset * 2, frames);
+        for (;;) {
+            const uint32_t produced
+                = stretcher->pull(block.data(), static_cast<uint32_t>(block.size()) / 2);
+            if (!produced)
+                break;
+            output.insert(output.end(), block.begin(), block.begin() + produced * 2);
+        }
+        if (sweep) {
+            const double progress = static_cast<double>(offset) / static_cast<double>(total_frames);
+            stretcher->set_ratio(static_cast<float>(1.0 + progress * 0.5));
+        }
+    }
+    return { input, std::move(output) };
+}
+
+std::vector<int16_t> sine(size_t frames, double frequency, double amplitude)
+{
+    std::vector<int16_t> samples(frames * 2);
+    for (size_t i = 0; i < frames; ++i) {
+        const int16_t value = static_cast<int16_t>(std::lround(amplitude * 32767.0
+            * std::sin(2.0 * 3.14159265358979323846 * frequency * static_cast<double>(i)
+                / static_cast<double>(kRate))));
+        samples[i * 2] = value;
+        samples[i * 2 + 1] = value;
+    }
+    return samples;
+}
+
+std::vector<int16_t> complex_signal(size_t frames)
+{
+    std::vector<int16_t> samples(frames * 2);
+    for (size_t i = 0; i < frames; ++i) {
+        const double t = static_cast<double>(i) / static_cast<double>(kRate);
+        const double envelope = 0.55 + 0.35 * std::sin(2.0 * 3.14159265358979323846 * 2.7 * t);
+        const double value = envelope
+            * (0.36 * std::sin(2.0 * 3.14159265358979323846 * 220.0 * t)
+                + 0.26 * std::sin(2.0 * 3.14159265358979323846 * 330.0 * t + 0.4)
+                + 0.12 * std::sin(2.0 * 3.14159265358979323846 * 1760.0 * t + 1.1));
+        const int16_t pcm = static_cast<int16_t>(std::lround(value * 32767.0));
+        samples[i * 2] = pcm;
+        samples[i * 2 + 1] = static_cast<int16_t>(-pcm / 2);
+    }
+    return samples;
+}
+
+double dominant_frequency(const std::vector<int16_t>& stereo, size_t start, size_t frames)
+{
+    int crossings = 0;
+    const size_t end = std::min(start + frames, stereo.size() / 2);
+    for (size_t i = start + 1; i < end; ++i) {
+        const int16_t previous = stereo[(i - 1) * 2];
+        const int16_t current = stereo[i * 2];
+        if ((previous < 0 && current >= 0) || (previous >= 0 && current < 0))
+            ++crossings;
+    }
+    return static_cast<double>(crossings) * kRate / (2.0 * static_cast<double>(end - start));
+}
+
+double max_step(const std::vector<int16_t>& stereo, size_t start, size_t end)
+{
+    double maximum = 0.0;
+    end = std::min(end, stereo.size() / 2);
+    for (size_t i = start + 1; i < end; ++i) {
+        maximum = std::max(maximum,
+            std::fabs(
+                static_cast<double>(stereo[i * 2]) - static_cast<double>(stereo[(i - 1) * 2])));
+    }
+    return maximum;
+}
+
+bool test_unity_ratio_reconstructs()
+{
+    const auto input = sine(kRate * 2, 440.0, 0.5);
+    const Run run = run_stretcher(input, 1.0f);
+    CHECK(run.output.size() > static_cast<size_t>(kRate + kRate / 2) * 2);
+    const size_t limit = std::min(run.input.size() / 2, run.output.size() / 2);
+    int worst = 0;
+    for (size_t i = NdsAudioTimeStretcher::kHopFrames; i < limit; ++i) {
+        worst = std::max(worst,
+            std::abs(static_cast<int>(run.input[i * 2]) - static_cast<int>(run.output[i * 2])));
+        worst = std::max(worst,
+            std::abs(
+                static_cast<int>(run.input[i * 2 + 1]) - static_cast<int>(run.output[i * 2 + 1])));
+    }
+    CHECK(worst <= 1);
+    CHECK(std::fabs(dominant_frequency(run.output, kRate / 2, kRate / 2) - 440.0) < 2.0);
+    return true;
+}
+
+bool test_ratio_preserves_pitch_and_duration(float ratio)
+{
+    const auto input = sine(kRate * 4, 440.0, 0.5);
+    const Run run = run_stretcher(input, ratio);
+    const double input_seconds = static_cast<double>(input.size() / 2) / kRate;
+    const double output_seconds = static_cast<double>(run.output.size() / 2) / kRate;
+    const double expected = input_seconds * ratio;
+    // The algorithm needs one window plus the search range of input before it
+    // can emit the final grain; that lookahead scales with the output ratio.
+    const double lookahead = static_cast<double>(NdsAudioTimeStretcher::kWindowFrames
+                                 + NdsAudioTimeStretcher::kSearchFrames)
+            / kRate * ratio
+        + static_cast<double>(NdsAudioTimeStretcher::kHopFrames) / kRate;
+    CHECK(output_seconds > expected - lookahead - 0.01);
+    CHECK(output_seconds < expected + 0.02);
+    CHECK(std::fabs(dominant_frequency(run.output, kRate, kRate) - 440.0) < 2.0);
+    const double input_step = max_step(input, kRate / 2, kRate * 2);
+    const double output_step = max_step(run.output, kRate / 2, kRate * 2);
+    CHECK(output_step <= input_step * 2.0 + 32.0);
+    return true;
+}
+
+bool test_complex_signal(float ratio)
+{
+    const auto input = complex_signal(kRate * 4);
+    const Run run = run_stretcher(input, ratio);
+    const double expected = 4.0 * ratio;
+    const double seconds = static_cast<double>(run.output.size() / 2) / kRate;
+    const double lookahead = static_cast<double>(NdsAudioTimeStretcher::kWindowFrames
+                                 + NdsAudioTimeStretcher::kSearchFrames)
+            / kRate * ratio
+        + static_cast<double>(NdsAudioTimeStretcher::kHopFrames) / kRate;
+    CHECK(seconds > expected - lookahead - 0.01);
+    CHECK(seconds < expected + 0.02);
+    const double input_step = max_step(input, 0, input.size() / 2);
+    const double output_step = max_step(run.output, kRate / 2, kRate * 2);
+    CHECK(output_step <= input_step * 2.0 + 32.0);
+    for (const int16_t sample : run.output) {
+        CHECK(sample > -32768 && sample < 32767);
+    }
+    return true;
+}
+
+bool test_variable_ratio()
+{
+    const auto input = sine(kRate * 4, 440.0, 0.5);
+    const Run run = run_stretcher(input, 1.0f, true);
+    CHECK(run.output.size() > static_cast<size_t>(kRate * 4 * 1.2) * 2);
+    CHECK(std::fabs(dominant_frequency(run.output, kRate, kRate) - 440.0) < 2.0);
+    const double input_step = max_step(input, kRate / 2, kRate * 2);
+    const double output_step = max_step(run.output, kRate / 2, kRate * 2);
+    CHECK(output_step <= input_step * 2.0 + 32.0);
+    return true;
+}
+
+bool test_overflow_is_bounded()
+{
+    auto stretcher = std::make_unique<NdsAudioTimeStretcher>();
+    stretcher->reset();
+    std::vector<int16_t> block((NdsAudioTimeStretcher::kInputCapacityFrames + 1) * 2, 0);
+    stretcher->push(block.data(), NdsAudioTimeStretcher::kInputCapacityFrames + 1);
+    CHECK(stretcher->buffered_input_frames() == NdsAudioTimeStretcher::kInputCapacityFrames);
+    CHECK(stretcher->overflow_frames == 1);
+    stretcher->push(block.data(), 16);
+    CHECK(stretcher->buffered_input_frames() == 16);
+    CHECK(stretcher->overflow_frames == NdsAudioTimeStretcher::kInputCapacityFrames + 1);
+    return true;
+}
+
+} // namespace
+
+int main()
+{
+    if (!test_unity_ratio_reconstructs())
+        return 1;
+    if (!test_ratio_preserves_pitch_and_duration(1.16f))
+        return 2;
+    if (!test_ratio_preserves_pitch_and_duration(1.5f))
+        return 3;
+    if (!test_ratio_preserves_pitch_and_duration(2.0f))
+        return 4;
+    if (!test_complex_signal(1.16f))
+        return 5;
+    if (!test_complex_signal(1.5f))
+        return 6;
+    if (!test_variable_ratio())
+        return 7;
+    if (!test_overflow_is_bounded())
+        return 8;
+    std::puts("audio_time_stretch_test: ok");
+    return 0;
+}
