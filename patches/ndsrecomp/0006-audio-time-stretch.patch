+
+bool require(bool value, const char* what, int line)
+{
+    if (!value)
+        std::fprintf(stderr, "FAIL line %d: %s\n", line, what);
+    return value;
+}
+
+#define CHECK(expr)                                                                                \
+    do {                                                                                           \
+        if (!require((expr), #expr, __LINE__))                                                     \
+            return false;                                                                          \
