+
+Run run_stretcher(const std::vector<int16_t>& input, float ratio, bool sweep = false)
+{
+    auto stretcher = std::make_unique<NdsAudioTimeStretcher>();
+    stretcher->reset();
+    stretcher->set_ratio(ratio);
