diff --git a/runner/src/audio_time_stretch.h b/runner/src/audio_time_stretch.h
new file mode 100644
index 0000000..6341847
--- /dev/null
+++ b/runner/src/audio_time_stretch.h
@@ -0,0 +1,217 @@
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstdint>
+
+// WSOLA time-scale modification for the frontend's stereo SPU stream.
+//
+// The runner advances one guest frame per frontend iteration, so a host that
+// cannot present 60 frames/s also produces audio below the device's 32728 Hz.
+// Playing that stream at the nominal rate empties SDL's queue and inserts hard
+// silence gaps. This stage resamples the stream in time, not in pitch: output
+// and input advance at different rates, while waveform periodicity is
+// preserved, so slow-motion gameplay keeps continuous, in-sync audio.
+struct NdsAudioTimeStretcher {
+    static constexpr uint32_t kWindowFrames = 1024;
+    static constexpr uint32_t kHopFrames = kWindowFrames / 2;
+    static constexpr uint32_t kSearchFrames = 192;
+    static constexpr uint32_t kCorrelationFrames = kHopFrames;
+    static constexpr uint32_t kInputCapacityFrames = 16384;
+    static constexpr float kMinRatio = 1.0f;
+    static constexpr float kMaxRatio = 2.0f;
+
+    static_assert((kInputCapacityFrames & (kInputCapacityFrames - 1)) == 0);
+    static_assert(kCorrelationFrames <= kWindowFrames);
+
+    std::array<int16_t, kInputCapacityFrames * 2> input {};
+    std::array<float, kWindowFrames * 2> accumulator {};
+    std::array<float, kWindowFrames> window {};
+    uint64_t write_abs = 0;
+    uint64_t read_abs = 0;
+    uint64_t previous_analysis = 0;
+    double analysis_phase = 0.0;
+    float current_ratio = kMinRatio;
+    uint64_t overflow_frames = 0;
+    bool window_ready = false;
+    bool started = false;
+
+    void reset()
+    {
+        std::fill(accumulator.begin(), accumulator.end(), 0.0f);
+        write_abs = 0;
+        read_abs = 0;
+        previous_analysis = 0;
+        analysis_phase = 0.0;
+        started = false;
+    }
+
+    void set_ratio(float ratio) { current_ratio = std::clamp(ratio, kMinRatio, kMaxRatio); }
+
+    float ratio() const { return current_ratio; }
+
+    uint32_t buffered_input_frames() const
+    {
+        const uint64_t buffered = write_abs - read_abs;
+        return buffered > kInputCapacityFrames ? kInputCapacityFrames
+                                               : static_cast<uint32_t>(buffered);
+    }
+
+    void push(const int16_t* stereo, uint32_t frames)
+    {
+        if (!stereo || frames == 0)
+            return;
+        if (frames > kInputCapacityFrames || write_abs - read_abs + frames > kInputCapacityFrames) {
+            // The pipeline pulls after every push, so this only happens if the
+            // backend stalled for more than half a second. Drop the backlog
+            // rather than corrupt the ring; the device queue is already the
+            // audible buffer in that situation.
+            const uint64_t buffered = write_abs - read_abs;
+            const uint64_t incoming_drop
+                = frames > kInputCapacityFrames ? frames - kInputCapacityFrames : 0;
+            overflow_frames += buffered + incoming_drop;
+            reset();
+            if (incoming_drop) {
+                stereo += incoming_drop * 2;
+                frames = kInputCapacityFrames;
+            }
+        }
+        constexpr uint64_t mask = kInputCapacityFrames - 1;
+        for (uint32_t i = 0; i < frames; ++i) {
+            const uint64_t slot = (write_abs + i) & mask;
+            input[slot * 2] = stereo[i * 2];
+            input[slot * 2 + 1] = stereo[i * 2 + 1];
+        }
+        write_abs += frames;
+    }
+
+    uint32_t pull(int16_t* stereo, uint32_t max_frames)
+    {
+        if (!stereo || max_frames < kHopFrames)
+            return 0;
+        ensure_window();
+        uint32_t produced = 0;
+        while (produced + kHopFrames <= max_frames) {
+            uint64_t analysis = 0;
+            if (!produce_grain(analysis))
+                break;
+            for (uint32_t i = 0; i < kHopFrames; ++i) {
+                stereo[(produced + i) * 2] = quantize(accumulator[i * 2]);
+                stereo[(produced + i) * 2 + 1] = quantize(accumulator[i * 2 + 1]);
+            }
+            produced += kHopFrames;
+            std::move(accumulator.begin() + kHopFrames * 2, accumulator.end(), accumulator.begin());
+            std::fill(accumulator.end() - kHopFrames * 2, accumulator.end(), 0.0f);
+        }
+        return produced;
+    }
+
+private:
+    void ensure_window()
+    {
+        if (window_ready)
+            return;
+        for (uint32_t i = 0; i < kWindowFrames; ++i) {
+            window[i] = static_cast<float>(0.5
+                - 0.5
+                    * std::cos(2.0 * 3.14159265358979323846 * static_cast<double>(i)
+                        / static_cast<double>(kWindowFrames)));
+        }
+        window_ready = true;
+    }
+
+    static int16_t quantize(float value)
+    {
+        const int32_t rounded = static_cast<int32_t>(value + (value >= 0.0f ? 0.5f : -0.5f));
+        return static_cast<int16_t>(std::clamp(rounded, -32768, 32767));
+    }
+
+    uint64_t available() const { return write_abs - read_abs; }
+
+    float mono_sample(uint64_t position) const
+    {
+        constexpr uint64_t mask = kInputCapacityFrames - 1;
+        const uint64_t slot = position & mask;
+        return static_cast<float>(input[slot * 2]) + static_cast<float>(input[slot * 2 + 1]);
+    }
+
+    double correlation(uint64_t target, uint64_t candidate) const
+    {
+        double dot = 0.0;
+        double target_energy = 0.0;
+        double candidate_energy = 0.0;
+        for (uint32_t i = 0; i < kCorrelationFrames; ++i) {
+            const double a = mono_sample(target + i);
+            const double b = mono_sample(candidate + i);
+            dot += a * b;
+            target_energy += a * a;
+            candidate_energy += b * b;
+        }
+        const double energy = std::sqrt(target_energy * candidate_energy);
+        return energy > 1.0 ? dot / energy : 0.0;
+    }
+
+    uint64_t search_analysis(uint64_t nominal) const
+    {
+        uint64_t low = nominal > kSearchFrames ? nominal - kSearchFrames : read_abs;
+        if (low < read_abs)
+            low = read_abs;
+        const uint64_t high = nominal + kSearchFrames;
+        if (low > high)
+            return nominal;
+
+        const uint64_t target = previous_analysis + kHopFrames;
+        double best = -2.0;
+        uint64_t best_position = std::clamp<uint64_t>(nominal, read_abs, write_abs - kWindowFrames);
+        for (uint32_t step = 0; step <= kSearchFrames; ++step) {
+            const uint64_t candidates[2] = { nominal + step, step == 0 ? nominal : nominal - step };
+            for (const uint64_t candidate : candidates) {
+                if (candidate < low || candidate > high)
+                    continue;
+                if (candidate + kWindowFrames > write_abs)
+                    continue;
+                const double score = correlation(target, candidate);
+                if (score > best + 1e-6) {
+                    best = score;
+                    best_position = candidate;
+                }
+            }
+        }
+        return best_position;
+    }
+
+    bool produce_grain(uint64_t& analysis)
+    {
+        if (!started) {
+            analysis = read_abs;
+            if (available() < kWindowFrames)
+                return false;
+        } else {
+            const double hop = static_cast<double>(kHopFrames) / static_cast<double>(current_ratio);
+            const uint64_t nominal = static_cast<uint64_t>(std::llround(analysis_phase + hop));
+            const bool searching = std::fabs(current_ratio - 1.0f) >= 0.005f;
+            const uint64_t lookahead = searching ? kSearchFrames : 0;
+            if (nominal + lookahead + kWindowFrames > write_abs)
+                return false;
+            analysis = searching ? search_analysis(nominal) : nominal;
+            if (analysis < read_abs)
+                analysis = read_abs;
+            if (analysis + kWindowFrames > write_abs)
+                return false;
+            analysis_phase += hop;
+        }
+
+        constexpr uint64_t mask = kInputCapacityFrames - 1;
+        for (uint32_t i = 0; i < kWindowFrames; ++i) {
+            const uint64_t slot = (analysis + i) & mask;
+            const float gain = window[i];
+            accumulator[i * 2] += static_cast<float>(input[slot * 2]) * gain;
+            accumulator[i * 2 + 1] += static_cast<float>(input[slot * 2 + 1]) * gain;
+        }
+        started = true;
+        previous_analysis = analysis;
+        read_abs = analysis > kSearchFrames ? analysis - kSearchFrames : 0;
+        return true;
+    }
+};
