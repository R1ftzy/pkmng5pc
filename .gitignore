# ROMs and game content (never commit)
roms/
*.nds
*.srl
*.sav
*.dsv
extracted/
bios/
bios9.bin
bios7.bin
firmware.bin
*.idb
*.i64
*.gpr
*.rep

# Emulator savestates (full game memory: proprietary content)
*.nss
*.ml[0-9]
*.dst

# Generated title banks (derived from the user's ROM; regenerable, never commit)
banks/

# ndsrecomp diagnostics bundles, written to the working directory unless
# --diagnostics-dir redirects them (tools/play sends them to banks/play/)
performance-*.jsonl
hostprof-*.ndshp
*.ndshp

# Build output
build/
build*/
out/
cmake-build-*/
CMakeUserPresets.json

# Editor / OS
.vs/
.vscode/
.idea/
*.user
Thumbs.db
.DS_Store
desktop.ini

# Compiled artifacts
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll
*.exe
*.pdb
*.ilk

# Local caches
.cache/
__pycache__/
*.pyc
*.log

# Launcher job logs
logs/

# TUI launcher local settings (paths and preferences only)
tui/.state.json
tui/.state.json.tmp

# Vendored ndsrecomp: regenerable generated banks + local perf output
third_party/ndsrecomp/generated/
third_party/ndsrecomp/perf-results/
